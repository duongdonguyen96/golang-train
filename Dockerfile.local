# Dev-only Dockerfile for local development with live reload via Air
# Uses bind-mounts for source code and keeps build artifacts inside the container.

FROM golang:1.25-alpine

WORKDIR /app

# Tools needed by go install/go mod and many Go deps
RUN apk add --no-cache git ca-certificates && update-ca-certificates

# Install Air (hot reload)
RUN go install github.com/air-verse/air@latest

# Cache deps first
COPY go.mod go.sum ./
RUN go mod download

# Copy the rest (optional when using bind-mount; still helpful for initial build)
COPY . .

EXPOSE 8080

# Air will rebuild and restart on code changes (config in .air.toml)
CMD ["air", "-c", ".air.toml"]
